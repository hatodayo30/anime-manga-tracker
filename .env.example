PORT=8090
DATABASE_URL=postgres://anime_manga:anime_manga@localhost:5432/anime_manga_tracker?sslmode=disable
# HTTPS でアクセスする環境では true にする（平文HTTPで true にするとログインできない）
COOKIE_SECURE=false
# AI 翻訳（Claude）。未設定なら MyMemory だけで動く。キーはコミットしない
# ANTHROPIC_API_KEY=
# 新刊（楽天ブックス書籍検索 API）。2 つとも揃っていなければ新刊の API は「未設定」を返す。キーはコミットしない
# RAKUTEN_APPLICATION_ID=
# RAKUTEN_ACCESS_KEY=
# 楽天のアプリ設定の「許可されたウェブサイト」に登録したサイト。Referer / Origin として送る（既定は下の値）
# RAKUTEN_REFERER=https://mirokuapp.com/
# 楽天アフィリエイト ID。商品ページへのリンクをアフィリエイト経由にする（楽天ウェブサービスの規約第 3 条）
# RAKUTEN_AFFILIATE_ID=
